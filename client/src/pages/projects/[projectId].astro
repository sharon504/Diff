---
export const prerender = false;
import MetadataWrapper from "@layouts/metadata-wrapper.astro";
import ProjectViewer from "@components/projects/project-viewer";
import Nav from "@components/common/nav";
const projectId = Astro.params.projectId ?? "";
---

<MetadataWrapper page={`${projectId}`}>
	<Nav current="Project" client:load />
	<ProjectViewer projectId={projectId} client:load />
</MetadataWrapper>
